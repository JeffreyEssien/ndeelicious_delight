# Copy into environment-specific secret storage. Never commit live values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API / Connect
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Reserved for trusted jobs; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# First admin identity. Fill these, then run: npm run admin:bootstrap
ADMIN_EMAIL=
ADMIN_NAME=Ndeeelicious Owner
# Optional direct SQL connections for migrations or a future ORM.
DATABASE_URL=postgresql://postgres.your-project-ref:password@your-pooler-host:6543/postgres
DIRECT_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EMAIL_PROVIDER_KEY=
SENTRY_DSN=
