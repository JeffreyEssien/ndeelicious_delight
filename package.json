{
  "name": "ndee_delicious",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint --changed .",
    "format": "biome format --write --changed .",
    "format:check": "biome format --changed .",
    "quality": "biome check --changed .",
    "test": "vitest run",
    "test:regression": "vitest run src/features src/lib src/validations",
    "test:functional": "vitest run src/app/api",
    "test:css": "node scripts/audit-css-tokens.mjs",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-workflow-integrity.mjs",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:structural": "npm run typecheck && npm run build",
    "check": "npm run quality && npm run test:css && npm run test:regression && npm run test:functional && npm run test:structural",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "db:seed": "node scripts/seed-catalog.mjs",
    "start": "next start",
    "test:db:local": "node scripts/test-cake-type-migrations.mjs && node scripts/test-commerce-migrations.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "fflate": "^0.8.3",
    "next": "16.3.8",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
