{
  "name": "ndee_delicious",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint --changed .",
    "format": "biome format --write --changed .",
    "format:check": "biome format --changed .",
    "quality": "biome check --changed .",
    "test": "vitest run",
    "test:regression": "vitest run src/features src/lib src/validations",
    "test:functional": "vitest run src/app/api",
    "test:structural": "npm run typecheck && npm run build",
    "check": "npm run quality && npm run test:regression && npm run test:functional && npm run test:structural",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "db:seed": "node scripts/seed-catalog.mjs",
    "start": "next start"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
